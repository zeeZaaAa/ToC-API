# ==========================================
# Core Django Settings
# ==========================================
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Generate a 50-character random string for this
# Run: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-this-with-a-50-character-random-string

# ==========================================
# Database Encryption
# ==========================================
# MUST be a 32-byte URL-safe base64-encoded string. Do NOT use the SECRET_KEY.
# Run: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-this-with-base64-encoded-fernet-key=

# ==========================================
# PostgreSQL Configuration
# ==========================================
DB_NAME=toc_db
DB_USER=postgres
DB_PASSWORD=your_local_db_password
DB_HOST=localhost
DB_PORT=5432
# ==========================================
# Django REST Framework and JWT Settings
# ==========================================
# Run: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SIMPLE_JWT_SECRET_KEY=your-dedicated-jwt-secret-key-here


GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FRONTEND_REDIRECT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173